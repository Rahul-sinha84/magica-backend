// Core tables.
// The pg_trgm extension (for the search indexes) is created by the chat_search migration.
//
// Constraints Prisma cannot express live as raw SQL at the end of the init migration:
//   - AgentRun_one_active_per_chat: partial unique index (one PENDING/RUNNING run per chat)
//   - User_credits_valid: CHECK (balance >= 0 AND held >= 0 AND held <= balance)
//   - CreditLedger_amount_nonzero: CHECK (amount <> 0)
// and at the end of the waitpoints migration:
//   - Waitpoint_one_pending_per_run: partial unique index (one PENDING waitpoint per run)
//   - Waitpoint_resolved_when_closed, Waitpoint_response_when_answered, Waitpoint_expires_after_creation: CHECKs

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Clerk user id
  email     String? // informational only: identity is the Clerk id, so this is deliberately not unique
  balance   Int      @default(0) // total credits; available = balance - held
  held      Int      @default(0) // credits reserved by in-flight runs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats        Chat[]
  messages     Message[]
  agentRuns    AgentRun[]
  creditLedger CreditLedger[]
  uploads      Upload[]
  mediaAssets  MediaAsset[]
}

model Chat {
  id            String   @id @default(cuid())
  userId        String
  title         String   @default("New chat")
  isPinned      Boolean  @default(false)
  lastMessageAt DateTime @default(now()) // never null, so keyset ordering is total
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  agentRuns AgentRun[]

  @@index([userId, isPinned(sort: Desc), lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Chat_title_trgm_idx") // search (pg_trgm)
}

model Message {
  id              String        @id @default(cuid())
  chatId          String
  userId          String
  role            MessageRole
  status          MessageStatus @default(COMPLETED)
  content         String?
  contentBlocks   Json          @default("[]") // ContentBlock[]; validated with Zod on write
  clientMessageId String? // client idempotency key
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  chat          Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggeredRuns AgentRun[]   @relation("TriggerMessage")
  assistantRun  AgentRun?    @relation("AssistantMessage")
  attachments   Attachment[]

  @@unique([chatId, clientMessageId]) // NULLs are distinct, so only client-supplied keys collide
  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_content_trgm_idx") // search (pg_trgm)
  @@index([userId]) // search: a common term reads only the caller's messages, never everyone's
}

model AgentRun {
  id                 String    @id @default(cuid())
  chatId             String
  userId             String
  triggerMessageId   String // the USER message that started this run
  assistantMessageId String    @unique // the ASSISTANT message this run produces
  triggerRunId       String?   @unique // Trigger.dev run id, set after dispatch
  status             RunStatus @default(PENDING)
  errorCode          String?
  errorMessage       String? // user-safe
  model              String? // the model OpenRouter actually routed to
  inputTokens        Int?
  outputTokens       Int?
  traceId            String
  // the failed or cancelled run this one retries; unique, so retrying the same run twice gives back the same retry
  retryOfRunId       String?   @unique
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  chat             Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerMessage   Message          @relation("TriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  assistantMessage Message          @relation("AssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Cascade)
  retryOf          AgentRun?        @relation("Retries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retriedBy        AgentRun?        @relation("Retries")
  loadedSkills     RunSkill[]
  toolInvocations  ToolInvocation[]
  creditLedger     CreditLedger[]
  waitpoints       Waitpoint[]

  @@index([chatId, createdAt(sort: Desc)])
  @@index([triggerMessageId])
  @@index([completedAt(sort: Desc)]) // the model status reads the most recently ended runs
}

// A skill the agent loaded during a run: the exact text it was given and its sha256, so a repeat load in the same run,
// or a retry of the run, gets the same guidance even if the skill file has changed since.
model RunSkill {
  id          String   @id @default(cuid())
  agentRunId  String
  skillName   String
  contentHash String // sha256 of `content`, lowercase hex
  content     String // the skill body as loaded
  loadedAt    DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, skillName])
}

model ToolInvocation {
  id           String               @id @default(cuid())
  agentRunId   String
  toolCallId   String // model-generated tool call id
  toolName     String
  status       ToolInvocationStatus @default(PENDING)
  input        Json
  output       Json?
  errorMessage String?
  magicaRunId  String? // Magica's run id, saved as soon as the run is started
  creditCost   Int? // app credits charged for this call (set when it is settled)
  providerCost Int? // what Magica reported the run used, in its microcredits (for reference and reconciliation)
  durationMs   Int?
  dispatchedAt DateTime? // set BEFORE the external call: tells "never sent" from "sent, outcome unknown"
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  agentRun    AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]

  @@unique([agentRunId, toolCallId])
}

// A pause in a run until the user answers it: approving a plan, or a spend above the approval threshold. The run waits
// on a Trigger.dev waitpoint token (it uses no worker while it waits); this row is the durable record, and it decides
// every race between an answer, the expiry and a stop. At most one is pending per run.
model Waitpoint {
  id             String          @id @default(cuid())
  agentRunId     String
  type           WaitpointType
  status         WaitpointStatus @default(PENDING)
  triggerTokenId String          @unique // the Trigger.dev token the run waits on, created before this row
  payload        Json // what is being approved (a plan, the calls and their costs); validated with Zod by type
  response       Json? // the answer ({ action, feedback? }), once answered
  expiresAt      DateTime // the token times out at the same moment
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, createdAt])
}

// Signed amount, from the point of view of the counter it changes:
//   GRANT +n / REFUND +n  -> User.balance
//   CHARGE -n             -> User.balance
//   HOLD +n / RELEASE -n  -> User.held
model CreditLedger {
  id             String     @id @default(cuid())
  userId         String
  agentRunId     String?
  type           LedgerType
  amount         Int
  reason         String
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agentRunId])
}

// A direct upload through Transloadit, one assembly per file. Created (PENDING) when the browser asks for a signed
// upload; completed or failed once Transloadit reports back. The finished file becomes a MediaAsset.
model Upload {
  id           String       @id @default(cuid())
  userId       String
  assemblyId   String?      @unique // Transloadit's assembly id, known once the upload has finished
  status       UploadStatus @default(PENDING)
  originalName String // cleaned of control characters
  mimeType     String // as declared when signing; Transloadit's detected type is checked on completion
  sizeBytes    Int // as declared when signing; replaced by Transloadit's measured size on completion
  errorMessage String? // user-safe
  mediaAssetId String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([createdAt]) // the monthly allowance adds up this month's uploads
}

// A file in the user's media library: one they uploaded (lives on Transloadit's temporary storage, so it expires) or
// one the agent generated (lives on Magica's CDN, no expiry). Messages refer to these through Attachment.
model MediaAsset {
  id               String      @id @default(cuid())
  userId           String
  source           MediaSource
  type             MediaType
  url              String
  expiresAt        DateTime? // uploads only; null for generated media
  name             String? // the file name, for uploads
  prompt           String? // what the agent was asked to make, for generated media
  model            String? // the model that made it, for generated media
  width            Int?
  height           Int?
  mimeType         String?
  toolInvocationId String? // the tool call that generated it
  createdAt        DateTime    @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolInvocation ToolInvocation? @relation(fields: [toolInvocationId], references: [id], onDelete: SetNull)
  upload         Upload?
  attachments    Attachment[]

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, source, createdAt(sort: Desc), id(sort: Desc)])
  @@index([toolInvocationId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "MediaAsset_name_trgm_idx") // library search
  @@index([prompt(ops: raw("gin_trgm_ops"))], type: Gin, map: "MediaAsset_prompt_trgm_idx") // library search
}

// A message's files, in the order they were attached (the order matters to the model).
model Attachment {
  id           String @id @default(cuid())
  messageId    String
  mediaAssetId String
  position     Int // 0-based, the order shown and given to the model

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@unique([messageId, mediaAssetId]) // the same file twice in one message is refused
  @@index([mediaAssetId])
}

enum UploadStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MediaSource {
  UPLOAD
  GENERATED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageStatus {
  COMPLETED
  FAILED
  CANCELLED
  STREAMING
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolInvocationStatus {
  PENDING
  DISPATCHING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WaitpointType {
  PLAN
  CREDIT
}

enum WaitpointStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum LedgerType {
  GRANT
  HOLD
  RELEASE
  CHARGE
  REFUND
}

# Copy to .env.local (loaded by `pnpm dev` / `pnpm start` via --env-file-if-exists).

# --- Shared (API server + Trigger.dev worker) ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://magica:magica@localhost:5432/magica_dev
# Used only by Prisma migrations (Phase 1); point at a non-pooled URL when deploying.
DIRECT_URL=postgresql://magica:magica@localhost:5432/magica_dev
# Connections per process (default 10). With many turns at once: 1-2 on the worker, behind a pooler.
# DATABASE_POOL_MAX=10
# Statement time limit sent on connect (default 15000). Set 0 behind a pooler that rejects it (then set it on the role).
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Only the free router is accepted; anything else fails at boot.
OPENROUTER_MODEL=openrouter/free

# --- API server ---
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
# Reverse proxies in front of the API (Railway and similar: 1). 0 when running locally.
TRUST_PROXY=0
# Same Clerk dev instance as magica-frontend.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
TRIGGER_SECRET_KEY=
# Integer credits (the UI shows millions as "M").
CREDIT_STARTING_BALANCE=30000000
CREDIT_ADMISSION_HOLD=100000

# Encrypts webhook signing secrets (API and worker need the same value): openssl rand -hex 32
# Optional: without it, asking for a webhook is answered "unavailable".
WEBHOOK_SECRET_KEY=
# Transloadit (uploads): the API signs each upload, so the secret never reaches the browser. Set both, or neither
# (then uploads answer "unavailable").
# TRANSLOADIT_AUTH_KEY=
# TRANSLOADIT_AUTH_SECRET=
# This API's public https address (e.g. the Railway domain). When set, Transloadit reports finished uploads to it
# directly, so an upload completes even if the browser closes. Leave unset locally (Transloadit can't reach it).
# PUBLIC_API_URL=

# --- Trigger.dev worker ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Turns that run at once; the rest wait in the queue (default 20; the free model's rate limit is the real ceiling).
# AGENT_CONCURRENCY_LIMIT=20
# A step whose paid tool calls are estimated above this asks the user to approve the spend first (default 600000:
# any single image runs without asking).
# CREDIT_APPROVAL_THRESHOLD=600000
# Magica model API, used by the worker's tools. Required; there is no default host.
MAGICA_API_KEY=
MAGICA_BASE_URL=https://inference.magica.com
# Read only by trigger.config.ts (Phase 6).
TRIGGER_PROJECT_REF=

# --- Tests ---
TEST_DATABASE_URL=postgresql://magica:magica@localhost:5432/magica_test

# --- Local Postgres (docker compose) ---
# POSTGRES_PORT=5432

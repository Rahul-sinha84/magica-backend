{
  "name": "magica-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#src/*": {
      "magica-source": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --no-experimental-webstorage --conditions=magica-source --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --no-experimental-webstorage --env-file-if-exists=.env.local dist/server.js",
    "trigger:dev": "NODE_OPTIONS=--no-experimental-webstorage trigger dev --env-file .env.local",
    "trigger:deploy": "NODE_OPTIONS=--no-experimental-webstorage trigger deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "contracts:sync": "tsx scripts/contracts-sync.ts",
    "smoke": "bash scripts/smoke.sh",
    "skills:check": "tsx --conditions=magica-source scripts/skills-check.ts",
    "magica:try": "tsx --conditions=magica-source --env-file-if-exists=.env.local scripts/magica-try.ts",
    "media:backfill": "tsx --conditions=magica-source --env-file-if-exists=.env.local scripts/media-backfill.ts",
    "docs:generate": "tsx --conditions=magica-source scripts/docs.ts",
    "docs:dev": "cd docs && npx -y mint@latest dev --port 3333",
    "docs:check": "cd docs && npx -y mint@latest validate && npx -y mint@latest broken-links"
  },
  "dependencies": {
    "@clerk/backend": "3.20.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@trigger.dev/sdk": "4.6.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "openai": "^7.23.0",
    "pino": "^10.3.1",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trigger.dev/build": "4.6.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prisma": "~7.10.0",
    "supertest": "^7.3.0",
    "svix": "^2.6.1",
    "trigger.dev": "4.6.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
